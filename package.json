{
	"name": "rpt-cli",
	"version": "0.1.0",
	"description": "AI agent flight recorder and verification engine: observes an agent run, re-derives the facts, scores risk, and gates the commit.",
	"type": "module",
	"bin": {
		"rpt": "./dist/cli/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"plugin",
		"docs/limits.md",
		"README.md"
	],
	"engines": {
		"node": ">=22"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KlyneChrysler/rpt.git"
	},
	"homepage": "https://github.com/KlyneChrysler/rpt#readme",
	"keywords": [
		"ai",
		"agent",
		"verification",
		"audit",
		"risk",
		"git-hooks",
		"claude-code",
		"observability"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run typecheck && npm run test && npm run build"
	},
	"dependencies": {
		"commander": "^12.1.0",
		"ink": "^5.2.1",
		"picomatch": "^4.0.2",
		"proper-lockfile": "^4.1.2",
		"react": "^18.3.1",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^22.7.5",
		"@types/picomatch": "^3.0.1",
		"@types/proper-lockfile": "^4.1.4",
		"@types/react": "^18.3.31",
		"@vitest/coverage-v8": "^2.1.2",
		"ink-testing-library": "^4.0.0",
		"typescript": "^5.6.3",
		"vitest": "^2.1.2"
	}
}
