{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"skipLibCheck": true,
		"jsx": "react-jsx"
	},
	"include": ["src"]
}
